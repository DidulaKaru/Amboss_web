{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/make-404.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "preview": "vite preview",
    "test:coverage": "vitest run --coverage",
    "test:selenium": "node --test --test-concurrency=1 selenium/amboss.selenium.test.mjs",
    "lint:complexity": "eslint -c eslint.complexity.config.mjs src/config/logistics.ts src/features/quote/utils/pricing.ts src/features/quote/utils/stlParser.ts"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.6",
    "three": "^0.186.1"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.1.16",
    "lightningcss-linux-x64-gnu": "^1.30.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "selenium-webdriver": "^4.51.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.4"
  }
}
