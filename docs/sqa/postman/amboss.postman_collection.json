        {
          "name": "TC-PM-18 A01 tampered JWT",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Well-formed header and payload with an invalid signature, built here so no JWT is stored in the repo",
                  "const part = (o) => btoa(JSON.stringify(o)).replace(/=+$/, '');",
                  "pm.variables.set('badJwt', [part({ alg: 'HS256' }), part({ role: 'admin' }), 'tampered'].join('.'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "amboss_admin_token={{badJwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
