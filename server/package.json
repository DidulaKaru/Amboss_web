    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.6.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
