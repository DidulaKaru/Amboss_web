# Server Environment Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Neon Postgres Pooled Connection URL (for live Fastify runtime queries)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon Postgres Direct Connection URL (unpooled, for running drizzle-kit migrate and seeds without PgBouncer transactional lock failures)
DATABASE_URL_DIRECT=postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Allowed CORS Origins (comma-separated, no trailing slashes)
CORS_ORIGIN=https://amboss.lk,https://www.amboss.lk

# Single-Owner Admin CMS Credentials
ADMIN_USERNAME=Dory
ADMIN_PASSWORD_HASH=$2b$10$if6Vv4XeouWjfdqpIvQBIurozAOyjzN0hpoCNlVTnJJ4eyrFlDpMG

# JWT Secret (generate a strong random string)
JWT_SECRET=replace-with-a-very-long-random-secret-key
